<Application x:Class="SeekIRWin.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SeekIRWin.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ===== пиктограммы тулбара (16x16) ===== -->
        <StreamGeometry x:Key="IcoPower">M8 2 L8 8 M4.6 4.6 A5.2 5.2 0 1 0 11.4 4.6</StreamGeometry>
        <StreamGeometry x:Key="IcoPause">M5 3 h2 v10 h-2 Z M9 3 h2 v10 h-2 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoPlay">M5 3 L12.5 8 L5 13 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoCamera">M2 5.5 h2.5 l1.2 -1.8 h4.6 l1.2 1.8 H14 v8 H2 Z M8 9.7 m-2.4 0 a2.4 2.4 0 1 0 4.8 0 a2.4 2.4 0 1 0 -4.8 0</StreamGeometry>
        <StreamGeometry x:Key="IcoRecord">M8 8 m-4 0 a4 4 0 1 0 8 0 a4 4 0 1 0 -8 0</StreamGeometry>
        <StreamGeometry x:Key="IcoStop">M4.5 4.5 h7 v7 h-7 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoGallery">M2 3 h12 v10 h-12 Z M4 10.5 l3 -3.5 2.2 2.4 2.4 -2.9 2.4 4 M6 6 m-0.9 0 a0.9 0.9 0 1 0 1.8 0 a0.9 0.9 0 1 0 -1.8 0</StreamGeometry>
        <StreamGeometry x:Key="IcoNoise">M2 10 q2 -5 4 0 t4 0 t4 0</StreamGeometry>
        <StreamGeometry x:Key="IcoSceneLines">M2 4.5 h12 M2 8 h12 M2 11.5 h12</StreamGeometry>
        <StreamGeometry x:Key="IcoSceneDots">M6 4.5 m-1.4 0 a1.4 1.4 0 1 0 2.8 0 a1.4 1.4 0 1 0 -2.8 0 M10 8 m-1.4 0 a1.4 1.4 0 1 0 2.8 0 a1.4 1.4 0 1 0 -2.8 0 M5 11.5 m-1.4 0 a1.4 1.4 0 1 0 2.8 0 a1.4 1.4 0 1 0 -2.8 0</StreamGeometry>
        <StreamGeometry x:Key="IcoCalibCircle">M8 8 m-5 0 a5 5 0 1 0 10 0 a5 5 0 1 0 -10 0</StreamGeometry>
        <StreamGeometry x:Key="IcoCalibCross">M8 1.5 v3 M8 11.5 v3 M1.5 8 h3 M11.5 8 h3</StreamGeometry>
        <StreamGeometry x:Key="IcoReport">M4 1.5 h5.5 L12.5 4.5 V14.5 H4 Z M6 7 h4 M6 9.5 h4 M6 12 h3</StreamGeometry>
        <StreamGeometry x:Key="IcoGear">M8 8 m-2.4 0 a2.4 2.4 0 1 0 4.8 0 a2.4 2.4 0 1 0 -4.8 0 M8 1.4 v2.1 M8 12.5 v2.1 M1.4 8 h2.1 M12.5 8 h2.1 M3.3 3.3 l1.5 1.5 M11.2 11.2 l1.5 1.5 M12.7 3.3 l-1.5 1.5 M4.8 11.2 l-1.5 1.5</StreamGeometry>
        <StreamGeometry x:Key="IcoThemeHalf">M8 3 a5 5 0 0 1 0 10 Z</StreamGeometry>
        <StreamGeometry x:Key="IcoThemeRing">M8 8 m-5.5 0 a5.5 5.5 0 1 0 11 0 a5.5 5.5 0 1 0 -11 0</StreamGeometry>

        <!-- контурные пиктограммы: цвет = Foreground кнопки (тускнеют если отключена) -->
        <Style x:Key="IcoStroke" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style x:Key="IcoFill" TargetType="Path">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- ===== текстовые поля: тема + закругления ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource CFgBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource CFgBrush}" />
            <Setter Property="Background" Value="{DynamicResource CBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- отвязка от нижнего колонтитула: паддинг только слева,
                                 вертикаль задаётся VerticalContentAlignment -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="7,0,7,0" Padding="0,4,0,4"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          VerticalContentAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource CAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBox: тема + закругления ===== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource CFgBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ib" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ib" Property="Background" Value="{DynamicResource CBtnHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource CFgBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource CFgBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="cb" CornerRadius="8"
                                                Background="{DynamicResource CBtnBgBrush}"
                                                BorderBrush="{DynamicResource CBorderBrush}"
                                                BorderThickness="1">
                                            <Path Data="M0 0 L4 4 L8 0" Stroke="{DynamicResource CFgDimBrush}"
                                                  StrokeThickness="1.2" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Margin="0,1,8,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cb" Property="Background" Value="{DynamicResource CBtnHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="9,0,22,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                                <Border Background="{DynamicResource CBgBrush}"
                                        BorderBrush="{DynamicResource CBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        TextElement.Foreground="{DynamicResource CFgBrush}">
                                    <ScrollViewer>
                                        <ItemsPresenter Margin="2" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox / Slider в теме -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource CFgBrush}" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource CAccentBrush}" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource CPanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CFgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CBorderBrush}" />
        </Style>
    </Application.Resources>
</Application>
