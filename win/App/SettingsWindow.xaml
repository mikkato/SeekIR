<Window x:Class="SeekIRWin.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки LLM"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CBgBrush}">
    <Grid Margin="14">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource CFgBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- эндпоинт -->
            <RowDefinition Height="Auto" /> <!-- ключ -->
            <RowDefinition Height="Auto" /> <!-- модель -->
            <RowDefinition Height="Auto" /> <!-- кнопки -->
            <RowDefinition Height="Auto" /> <!-- статус -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Эндпоинт (…/v1)" Margin="0,4" />
        <TextBox x:Name="TxtUrl" Grid.Row="0" Grid.Column="1" Height="26" Margin="0,4"
                 VerticalContentAlignment="Center" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="API-ключ" Margin="0,4" />
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="TxtKey" Height="26" VerticalContentAlignment="Center" />
            <Button x:Name="BtnKeyEye" Grid.Column="1" Width="30" Height="26" Margin="4,0,0,0"
                    Content="…" Click="OnKeyEye" ToolTip="Показать/скрыть ключ" />
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Модель" Margin="0,4" />
        <Grid Grid.Row="2" Grid.Column="1" Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtModel" Height="26" VerticalContentAlignment="Center" />
            <Button x:Name="BtnFetch" Grid.Column="1" Height="26" Margin="4,0,0,0" Padding="8,0"
                    Content="Список" Click="OnFetchModels"
                    ToolTip="Загрузить список моделей с эндпоинта (/models)" />
        </Grid>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                    Margin="0,10,0,0">
            <Button x:Name="BtnTest" Content="Проверить связь" Height="26" Padding="10,0"
                    Click="OnTest" ToolTip="Отправить тестовый запрос /chat/completions на заданных эндпоинте и модели" />
            <Button x:Name="BtnOk" Content="Сохранить" Height="26" Padding="14,0" Margin="8,0,0,0"
                    Click="OnOk" />
            <Button x:Name="BtnCancel" Content="Отмена" Height="26" Padding="10,0" Margin="8,0,0,0"
                    Click="OnCancel" />
        </StackPanel>

        <TextBlock x:Name="TxtStatus" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource CFgDimBrush}" />
    </Grid>
</Window>
