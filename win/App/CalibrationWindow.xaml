<Window x:Class="SeekIRWin.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калибровка (под управлением LLM)" Width="560" Height="600"
        Background="{DynamicResource CBgBrush}" Loaded="OnLoaded" Closed="OnClosedWin">
    <DockPanel Margin="10">
        <!-- живая инструкция модели; дублируется баннером на кадре -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CPanelBrush}"
                BorderBrush="{DynamicResource CBorderBrush}" BorderThickness="1" Padding="8,6"
                Margin="0,0,0,8">
            <TextBlock x:Name="TxtHint" TextWrapping="Wrap" MinHeight="34" FontSize="13"
                       Foreground="{DynamicResource CFgBrush}" Text="Ожидаю телеметрию…" />
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Закрыть"
                    Width="70" Height="24" Margin="6,0,0,0" Click="OnCloseClick" />
            <Button x:Name="BtnFit" DockPanel.Dock="Right" Content="Калибровать"
                    Width="96" Height="24" Margin="6,0,0,0" IsEnabled="False" Click="OnFit" />
            <Button x:Name="BtnGrab" DockPanel.Dock="Right" Content="Зафиксировать точку"
                    Width="140" Height="24" Margin="6,0,0,0" IsEnabled="False" Click="OnGrab" />
            <Button x:Name="BtnCheck" DockPanel.Dock="Right" Content="Проверить (LLM)"
                    Width="120" Height="24" Margin="6,0,0,0" Click="OnCheck" />
            <CheckBox x:Name="ChkAuto" Content="Авто (точки и фит без кнопок)"
                      VerticalAlignment="Center" FontSize="12"
                      ToolTip="модель сама фиксирует точки по типовым температурам объектов и запускает фит" />
            <TextBox x:Name="TxtTrueC" Height="24" VerticalContentAlignment="Center"
                     Text="36.6" ToolTip="Истинная температура опорного тела, °C (контактный термометр)" />
        </DockPanel>
        <TextBlock x:Name="TxtStatus" DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="11"
                   TextWrapping="Wrap" Foreground="{DynamicResource CFgDimBrush}"
                   Text="Подготовьте первое опорное тело." />
        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Log" />
        </ScrollViewer>
    </DockPanel>
</Window>
