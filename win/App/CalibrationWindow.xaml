<Window x:Class="SeekIRWin.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калибровка" Width="600" Height="620"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource CBgBrush}" Loaded="OnLoaded" Closed="OnClosedWin">
    <DockPanel Margin="10">
        <!-- выбор алгоритма: явно, два взаимно исключающих режима -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CPanelBrush}"
                BorderBrush="{DynamicResource CBorderBrush}" BorderThickness="1" Padding="8,6"
                Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Алгоритм:" FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,10,0" Foreground="{DynamicResource CFgBrush}" />
                    <RadioButton x:Name="RbtStd" Content="Стандартный (2 точки, без LLM)"
                                 GroupName="calmode" FontSize="12" IsChecked="True"
                                 Checked="OnMode"
                                 ToolTip="Классическая 2-точечная планк-калибровка: два опорных тела с известной температурой (ΔT ≥ 10 °C), стабилизация, локальные проверки. Модель не участвует." />
                    <RadioButton x:Name="RbtLlm" Content="С помощником LLM" Margin="14,0,0,0"
                                 GroupName="calmode" FontSize="12" Checked="OnMode"
                                 ToolTip="Модель видит телеметрию (и кадр в авто-режиме), ведёт оператора, фиксирует точки и проверяет результат." />
                </StackPanel>
                <TextBlock x:Name="TxtAlgoNote" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource CFgDimBrush}" />
            </StackPanel>
        </Border>
        <!-- живая инструкция модели; дублируется баннером на кадре -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CPanelBrush}"
                BorderBrush="{DynamicResource CBorderBrush}" BorderThickness="1" Padding="8,6"
                Margin="0,0,0,8">
            <TextBlock x:Name="TxtHint" TextWrapping="Wrap" MinHeight="34" FontSize="13"
                       Foreground="{DynamicResource CFgBrush}" Text="Ожидаю телеметрию…" />
        </Border>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Закрыть"
                    Width="70" Height="24" Margin="6,0,0,0" Click="OnCloseClick" />
            <Button x:Name="BtnFit" DockPanel.Dock="Right" Content="Калибровать"
                    Width="96" Height="24" Margin="6,0,0,0" IsEnabled="False" Click="OnFit" />
            <Button x:Name="BtnGrab" DockPanel.Dock="Right" Content="Зафиксировать точку"
                    Width="140" Height="24" Margin="6,0,0,0" IsEnabled="False" Click="OnGrab" />
            <Button x:Name="BtnCheck" DockPanel.Dock="Right" Content="Проверить"
                    Width="86" Height="24" Margin="6,0,0,0" Click="OnCheck" />
            <CheckBox x:Name="ChkAuto" Content="Авто" Visibility="Collapsed"
                      VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"
                      ToolTip="модель сама фиксирует точки по типовым температурам объектов и запускает фит" />
            <TextBox x:Name="TxtTrueC" Height="24" VerticalContentAlignment="Center"
                     Text="36.6" ToolTip="Истинная температура опорного тела, °C (контактный термометр)" />
        </DockPanel>
        <TextBlock x:Name="TxtStatus" DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="11"
                   TextWrapping="Wrap" Foreground="{DynamicResource CFgDimBrush}"
                   Text="Подготовьте первое опорное тело." />
        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Log" />
        </ScrollViewer>
    </DockPanel>
</Window>
