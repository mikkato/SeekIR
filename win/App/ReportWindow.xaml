<Window x:Class="SeekIRWin.App.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интервью и отчёт" Width="560" Height="560"
        Background="{DynamicResource CBgBrush}" Loaded="OnLoaded">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="BtnPdf" DockPanel.Dock="Right" Content="Отчёт в PDF"
                    Width="96" Height="24" Margin="6,0,0,0" Click="OnPdf" />
            <Button x:Name="BtnSend" DockPanel.Dock="Right" Content="Отправить"
                    Width="80" Height="24" Margin="6,0,0,0" Click="OnSend" />
            <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Закрыть"
                    Width="70" Height="24" Margin="6,0,0,0" Click="OnCloseClick" />
            <TextBox x:Name="TxtInput" Height="46" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     KeyDown="OnKey" />
        </DockPanel>
        <TextBlock x:Name="TxtStatus" DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="11"
                   Foreground="{DynamicResource CFgDimBrush}" Text="" />
        <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Chat" />
        </ScrollViewer>
    </DockPanel>
</Window>
