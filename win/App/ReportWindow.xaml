<Window x:Class="SeekIRWin.App.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Интервью и отчёт" Width="620" Height="640"
        Background="{DynamicResource CBgBrush}" Loaded="OnLoaded">
    <Window.Resources>
        <!-- плоский стиль кнопки (как в главном окне) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CBtnBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CFgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CBtnHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource CFgDimBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- нижняя консоль ввода: поле + кнопки в одной секции -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CBorderBrush}"
                BorderThickness="0,1,0,0" Background="{DynamicResource CPanelBrush}" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom"
                            Margin="8,0,0,0">
                    <Button x:Name="BtnSend" Content="Отправить ↑" Width="92" Height="28"
                            Click="OnSend" IsDefault="True" />
                    <Button x:Name="BtnPdf" Content="Отчёт в PDF" Width="92" Height="28"
                            Margin="6,0,0,0" Click="OnPdf" />
                    <Button x:Name="BtnClose" Content="Закрыть" Width="70" Height="28"
                            Margin="6,0,0,0" Click="OnCloseClick" />
                </StackPanel>
                <Border BorderBrush="{DynamicResource CBorderBrush}" BorderThickness="1"
                        Background="{DynamicResource CBgBrush}">
                    <TextBox x:Name="TxtInput" MinHeight="44" MaxHeight="120" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" Padding="6,4"
                             Foreground="{DynamicResource CFgBrush}" KeyDown="OnKey" />
                </Border>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CStatusBgBrush}">
            <TextBlock x:Name="TxtStatus" Margin="12,4" FontSize="11"
                       Foreground="{DynamicResource CFgDimBrush}" Text="" />
        </Border>
        <!-- заголовок -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CBorderBrush}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="TxtModel" FontSize="11"
                           Foreground="{DynamicResource CFgDimBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Интервью по термограмме" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource CFgBrush}" />
            </DockPanel>
        </Border>
        <Grid>
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="12,10">
                <StackPanel x:Name="Chat" />
            </ScrollViewer>
            <!-- индикатор «модель думает» -->
            <Border x:Name="TypingPill" Visibility="Collapsed" HorizontalAlignment="Left"
                    VerticalAlignment="Bottom" Margin="16,0,0,12"
                    Background="{DynamicResource CPanelBrush}"
                    BorderBrush="{DynamicResource CBorderBrush}" BorderThickness="1" Padding="8,3">
                <TextBlock x:Name="TypingTxt" Text="модель думает…" FontSize="11"
                           Foreground="{DynamicResource CFgDimBrush}" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
